# HyprAgent Configuration
# Copy to config.yaml and fill in your values.
# Credentials must be set via environment variables — do not hardcode API keys here.

backend:
  active: claude   # claude | gemini | ollama | openai_compatible

  claude:
    model: claude-sonnet-4-6
    api_key_env: ANTHROPIC_API_KEY   # export ANTHROPIC_API_KEY=sk-ant-...

  gemini:
    model: gemini-2.5-flash
    api_key_env: GEMINI_API_KEY      # export GEMINI_API_KEY=...

  ollama:
    endpoint: http://localhost:11434
    model: llava                      # must support vision; e.g. llava, minicpm-v

  openai_compatible:
    model: kimi-k2.5                  # any vision-capable model supported by the endpoint
    base_url: https://opencode.ai/zen/go/v1   # OpenCode Go, OpenRouter, OpenAI, vLLM, etc.
    api_key_env: OPENCODE_GO_API_KEY  # export OPENCODE_GO_API_KEY=...

loop:
  max_steps: 20                       # abort after this many perceive→act cycles
  screenshot_on_every_step: true      # capture screen before each reasoning step
  confirm_destructive_actions: true   # prompt before file write/move/delete
  scale_screenshots: true             # scale screenshots down for token efficiency
  scale_max_width: 1024               # max scaled screenshot width
  scale_max_height: 768               # max scaled screenshot height
  kill_switch_key: "ctrl+shift+escape"

safety:
  command_blocklist:
    - "rm -rf /"
    - "dd if="
    - "mkfs"
    - ":(){:|:&};:"                   # fork bomb
  screenshot_format: png              # png recommended for OCR accuracy
  ocr_language: eng                   # tesseract language code

tools:
  mouse:
    screen_width: 2560     # REQUIRED — must match actual display resolution
    screen_height: 1440    # REQUIRED — must match actual display resolution
    # Find your resolution: hyprctl monitors -j | python3 -c "import json,sys; m=json.load(sys.stdin)[0]; print(m['width'], m['height'])"
    click_delay_ms: 50     # delay between button down and up
    drag_step_px: 10       # interpolation step for drag moves
    scroll_delay_ms: 20    # delay between scroll ticks

  keyboard:
    type_delay_ms: 12      # delay between keystrokes (ms)
    use_clipboard_fallback: true   # paste unmapped chars via wl-clipboard
