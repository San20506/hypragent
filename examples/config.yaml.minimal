# Minimal HyprAgent config
# Copy to config.yaml and edit as needed
#
# Required: export ANTHROPIC_API_KEY=sk-ant-... before running

backend:
  active: claude
  claude:
    model: claude-sonnet-4-20250514
    api_key_env: ANTHROPIC_API_KEY

loop:
  max_steps: 10
  screenshot_on_every_step: true
  confirm_destructive_actions: true

safety:
  command_blocklist:
    - "rm -rf /"
    - "dd if="
    - "mkfs"
    - ":(){:|:&};:"
